{
    "name": "manhhuyvo/action-response",
    "description": "A simple and standardized response object for an action in PHP projects.",
    "autoload": {
        "psr-4": {
            "ManhHuyVo\\ActionResponse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Manh Huy Vo"
        }
    ],
    "require": {
        "illuminate/support": "^12.32"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "symfony/var-dumper": "^7.3"
    }
}
